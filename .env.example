# Required environment variables for docker compose
# Copy this file to .env and fill in real values before running.

DB_PASSWORD=          # PostgreSQL password (use a strong, random value)
SECRET_KEY=           # FastAPI secret key (use a strong, random value)
API_KEY=              # API key for write operations on the CourseCatalog API

# --- Activity feed (all optional: a source is skipped if its variables are empty) ---
GITHUB_USERNAME=disi910
GITHUB_TOKEN=         # optional; raises the API rate limit (no scopes needed)
LEETCODE_USERNAME=
LETTERBOXD_USERNAME=
SPOTIFY_CLIENT_ID=    # see feed/scripts/spotify_auth.py
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
FEED_API_KEY=         # enables POST /api/status for manual status updates
